SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SHARE_URL=
UPLOAD_TTL_DAYS=30
UPLOAD_CLEANUP_INTERVAL_HOURS=24
DISCORD_WEBHOOK_URL=

# Optional user login (leave empty to disable a provider)
# Public base URL, used to build the OAuth redirect URIs
PUBLIC_URL=
# Redirect URI to register: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: {PUBLIC_URL}/api/auth/apple/callback (Services ID = APPLE_CLIENT_ID)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM content with \n escapes, or a path to the .p8 file
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=
