SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SHARE_URL=
UPLOAD_TTL_DAYS=30
UPLOAD_CLEANUP_INTERVAL_HOURS=24
DISCORD_WEBHOOK_URL=
# Rate limiting (per client IP). Defaults shown.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
RATE_LIMIT_IMAGE_PER_MINUTE=6
RATE_LIMIT_IMAGE_BURST=3
# Set to true behind a reverse proxy (e.g. Traefik) so the real client IP is used.
# Only enable if the app is NOT directly reachable from the internet.
TRUST_PROXY=false
# Header carrying the client IP (default X-Forwarded-For; CF-Connecting-IP if Cloudflare is in front)
CLIENT_IP_HEADER=X-Forwarded-For
